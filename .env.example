# Store Locator Admin Panel
#
# Server-only Firebase Admin configuration.
# Prefer workload identity / GOOGLE_APPLICATION_CREDENTIALS in hosted environments.
# For local development, paste the service-account values here and keep .env.local out of Git.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key-escaped-newlines"
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STORAGE_BUCKET=

# Public Firebase Web SDK config used by the admin login page.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Session cookie settings.
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_EXPIRES_IN_MS=432000000
# Local smoke only. Keep this disabled in production.
ADMIN_ALLOW_ID_TOKEN_SESSION_FOR_SMOKE=0

# Optional broadcast integrations.
SENDGRID_API_KEY=
EMAIL_BROADCAST_LIMIT=500
PUSH_BROADCAST_LIMIT=500
UPLOAD_MAX_FILE_SIZE_MB=10
